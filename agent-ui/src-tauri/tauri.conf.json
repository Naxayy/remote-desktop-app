{
  "productName": "Remote Desktop App - Agent",
  "version": "0.1.0",
  "identifier": "com.nicolas.remotedesktopapp.agentui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remote Desktop App - Configuración",
        "width": 420,
        "height": 380,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Remote Desktop App - Agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Nicolas Carmona"
  }
}
